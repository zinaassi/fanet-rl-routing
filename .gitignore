# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Generated simulation / training artifacts (regenerable — keep out of git)
# ---------------------------------------------------------------------------
# Stage-1 per-episode event logs (can be multiple GB).
logs/

# Trained model checkpoints (produced by train.py).
*.pt

# Animations produced by main.py / eval.py / demo_vis.py.
*.gif

# Experiment output. The FIGURES are committed -- they are the Phase-1a
# results we refer to, and regenerating them takes a full 160-run grid. The
# CSVs behind them stay out: they are large, churn on every rerun, and the
# scripts reproduce them exactly.
# NOTE: the directory itself must not be excluded, or git will not descend
# into it and the negation below would never be seen.
rl_sim/out/*
!rl_sim/out/*.png

# ---------------------------------------------------------------------------
# Scratch / temp
# ---------------------------------------------------------------------------
scratch/
*.tmp

# ---------------------------------------------------------------------------
# OS / download cruft
# ---------------------------------------------------------------------------
*:Zone.Identifier
.DS_Store
Thumbs.db
