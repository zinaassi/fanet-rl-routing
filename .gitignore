# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Generated simulation / training artifacts (regenerable — keep out of git)
# ---------------------------------------------------------------------------
# Stage-1 per-episode event logs (can be multiple GB).
logs/

# Trained model checkpoints (produced by train.py).
*.pt

# Animations produced by main.py / eval.py / demo_vis.py.
*.gif

# Experiment output. The FIGURES and the SMALL RESULT TABLES are committed:
# they are the Phase-1a results we refer to, and regenerating them takes a
# full 160-run grid. The big per-run CSV stays out -- it is ~40 KB, churns on
# every rerun, and the summary tables are derived from it.
# NOTE: the directory itself must not be excluded, or git will not descend
# into it and the negations below would never be seen.
rl_sim/out/*
!rl_sim/out/*.png
!rl_sim/out/1a_summary.csv
!rl_sim/out/1a_paired.csv
!rl_sim/out/range_check.csv
!rl_sim/out/edge_scan.csv
!rl_sim/out/1b_*.csv
!rl_sim/out/queue_size_paired.csv
!rl_sim/out/queue_size_1a.csv
# Phase-2a: the frozen static reference and the layout hashes behind it.
!rl_sim/out/2a_*.csv

# ---------------------------------------------------------------------------
# Scratch / temp
# ---------------------------------------------------------------------------
scratch/
*.tmp

# ---------------------------------------------------------------------------
# OS / download cruft
# ---------------------------------------------------------------------------
*:Zone.Identifier
.DS_Store
Thumbs.db
!rl_sim/out/2c_*.csv
# The curriculum records its settings and seeds as JSON beside its CSVs.
!rl_sim/out/2c_*.json
# The edge-case tables and pictures are committed; the per-step recordings
# they are drawn from are regenerable and stay out.
!rl_sim/out/2c_edge/
rl_sim/out/2c_edge/rec/

# The Phase-2c networks themselves. out/models/ is ignored wholesale above,
# so each level has to be let through before the files inside can be: the
# directory, then everything directly in it back out, then 2c/ and its
# weights. Only 2c/ is tracked; the loose M1/M2/M3 files keep their old
# paths, and the copies under 2c/ are what the repo carries.
!rl_sim/out/models/
rl_sim/out/models/*
!rl_sim/out/models/2c/
!rl_sim/out/models/2c/*.pt
